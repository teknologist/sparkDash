    {
      "id": "mimo",
      "name": "MiMo-V2.5 (dual)",
      "description": "MiMo-V2.5 Omni · TP=2 over Ray across spark1 + spark2",
      "sparks": ["spark1", "spark2"],
      "startParallel": false,
      "detect": { "localContainers": ["mimo-nvfp4"] },
      "components": [
        {
          "id": "mimo",
          "target": "local",
          "cwd": "/home/eric/deploy/mimo",
          "start": { "cmd": "bash", "args": ["start.sh"] },
          "stop": { "cmd": "bash", "args": ["stop.sh"] },
          "status": { "cmd": "bash", "args": ["start.sh", "--check"] },
          "startTimeoutMs": 1200000,
          "ready": [{ "host": "127.0.0.1", "port": 8000, "servedModel": "MiMo" }]
        }
      ]
    },
