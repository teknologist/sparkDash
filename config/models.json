{
  "version": 1,
  "_comment": "Model catalog ('bricks') for the RAM-aware composer. ramGB is an EDITABLE estimate of resident unified-memory footprint (weights + KV at the configured ctx) on a 128 GB GB10 node; tune against the live 'used' figure the composer shows. placement 'dual' occupies BOTH nodes (TP=2) and is exclusive. Each launch node uses {cmd,args} per action so a brick can start locally or over ssh.",
  "nodeCapacityGB": { "spark1": 128, "spark2": 128 },
  "models": [
    {
      "id": "deepseek-v4-flash-0731-entrpi",
      "displayName": "DeepSeek V4 Flash 0731 (Entrpi 1-node)",
      "backend": "ds4",
      "placement": "single",
      "nodes": ["spark1"],
      "ramGB": 90,
      "port": 8000,
      "servedModel": "deepseek-v4-flash",
      "notes": "Single-node ds4 (Entrpi/ds4 fork v0.5.x, CUDA sm_121) serving the DeepSeek-V4-Flash-0731 IQ2XXS/Q2K GGUF (~81 GiB, in-RAM) + DSpark, ctx 200k. Fast single-node alternative to the 2-node NVFP4 dual; lower-precision 2-bit quant. Boots in ~10s.",
      "launch": {
        "spark1": {
          "target": "local",
          "startTimeoutMs": 600000,
          "start": { "cmd": "/home/eric/ds4-entrpi.sh", "args": ["start"] },
          "stop": { "cmd": "/home/eric/ds4-entrpi.sh", "args": ["stop"] },
          "status": { "cmd": "/home/eric/ds4-entrpi.sh", "args": ["status"] },
          "ready": { "host": "127.0.0.1", "port": 8000, "servedModel": "deepseek-v4-flash" }
        }
      }
    },
    {
      "id": "laguna-s",
      "displayName": "Laguna-S 2.1",
      "backend": "vllm",
      "placement": "single",
      "nodes": ["spark1", "spark2"],
      "ramGB": 72,
      "port": 8000,
      "servedModel": "laguna-s",
      "notes": "NVFP4 + DFlash spec-decode (ENABLE_SPEC=1), ctx 256k, util 0.80.",
      "launch": {
        "spark1": {
          "target": "local",
          "env": { "ENABLE_SPEC": "1" },
          "startTimeoutMs": 1200000,
          "start": { "cmd": "/home/eric/deploy/laguna/serve.sh", "args": [] },
          "stop": { "cmd": "docker", "args": ["stop", "laguna-s"] },
          "status": { "cmd": "bash", "args": ["-lc", "curl -fsS --max-time 4 http://127.0.0.1:8000/v1/models >/dev/null 2>&1 && echo up || echo down"] },
          "ready": { "host": "127.0.0.1", "port": 8000, "servedModel": "laguna-s" }
        },
        "spark2": {
          "target": "ssh",
          "host": "Spark2",
          "env": { "ENABLE_SPEC": "1" },
          "startTimeoutMs": 1200000,
          "start": { "cmd": "~/deploy/laguna/laguna-ctl.sh", "args": ["start"] },
          "stop": { "cmd": "~/deploy/laguna/laguna-ctl.sh", "args": ["stop"] },
          "status": { "cmd": "~/deploy/laguna/laguna-ctl.sh", "args": ["status"] },
          "ready": { "host": "10.100.72.1", "port": 8000, "servedModel": "laguna-s" }
        }
      }
    },
